#!/bin/sh
# jeronix-desktop prerm: gives the login screen and boot splash back to
# Ubuntu's before the package's files go. Generated by
# packaging/jeronix_payload.py.
set -e

GREETER=/usr/share/gnome-shell/theme/JERONIX/gnome-shell-theme.gresource
PLYMOUTH=/usr/share/plymouth/themes/jeronix/jeronix.plymouth
PLYMOUTH_TEXT=/usr/share/plymouth/themes/jeronix-text/jeronix-text.plymouth

case "$1" in
    remove|deconfigure)
        update-alternatives --remove gdm-theme.gresource "$GREETER" || true
        rm -f "$GREETER"
        rmdir /usr/share/gnome-shell/theme/JERONIX 2>/dev/null || true
        update-alternatives --remove default.plymouth "$PLYMOUTH" || true
        update-alternatives --remove text.plymouth "$PLYMOUTH_TEXT" || true
        ;;
esac

exit 0
