#!/bin/sh
# jeronix-desktop postrm: puts Ubuntu's own files back (undoes preinst's
# diversions) and rebuilds the boot splash and boot menu with them.
# Generated by packaging/jeronix_payload.py.
set -e

PKG=jeronix-desktop
DIVERSIONS="@DIVERSIONS@"

case "$1" in
    remove|abort-install|disappear)
        for path in $DIVERSIONS; do
            if dpkg-divert --listpackage "$path" 2>/dev/null | grep -qx "$PKG"; then
                dpkg-divert --package "$PKG" --remove --rename --divert "$path.ubuntu" "$path"
            fi
        done
        if [ "$1" = remove ]; then
            if command -v update-initramfs >/dev/null; then
                update-initramfs -u || echo "jeronix-desktop: update-initramfs failed" >&2
            fi
            if command -v update-grub >/dev/null && [ -e /boot/grub/grub.cfg ]; then
                update-grub || echo "jeronix-desktop: update-grub failed" >&2
            fi
        fi
        ;;
esac

exit 0
