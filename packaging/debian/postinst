#!/bin/sh
# jeronix-desktop postinst: the JERONIX login screen, boot splash and boot
# menu name. Each step is optional: if one fails, a warning is printed and
# the system keeps what it had (Ubuntu's login screen, splash or menu), so
# installing JERONIX never leaves a broken boot or login.
# Generated by packaging/jeronix_payload.py.
set -e

GREETER=/usr/share/gnome-shell/theme/JERONIX/gnome-shell-theme.gresource
PLYMOUTH=/usr/share/plymouth/themes/jeronix/jeronix.plymouth
PLYMOUTH_TEXT=/usr/share/plymouth/themes/jeronix-text/jeronix-text.plymouth

warn() {
    echo "jeronix-desktop: $*" >&2
}

login_screen() {
    if python3 /usr/share/jeronix/scripts/jeronix_greeter.py install "$GREETER" \
        --css /usr/share/gnome-shell/extensions/jeronix-shell-theme@jeronix/stylesheet-dark.css \
        --background /usr/share/jeronix/branding/jeronix-login-background.png; then
        update-alternatives --install /usr/share/gnome-shell/gdm-theme.gresource \
            gdm-theme.gresource "$GREETER" 50 || warn "login screen theme not registered"
    else
        warn "the JERONIX login screen could not be built; the current one stays"
    fi
}

boot_splash() {
    if [ -e "$PLYMOUTH" ] && command -v update-alternatives >/dev/null; then
        update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
            default.plymouth "$PLYMOUTH" 150 || warn "boot splash not registered"
    fi
    if [ -e "$PLYMOUTH_TEXT" ] && command -v update-alternatives >/dev/null; then
        update-alternatives --install /usr/share/plymouth/themes/text.plymouth \
            text.plymouth "$PLYMOUTH_TEXT" 150 || warn "text boot splash not registered"
    fi
    if command -v update-initramfs >/dev/null; then
        update-initramfs -u || warn "update-initramfs failed; the boot splash changes after the next kernel update"
    fi
}

boot_menu() {
    # GRUB names the system after /etc/os-release (GRUB_DISTRIBUTOR).
    if command -v update-grub >/dev/null && [ -e /boot/grub/grub.cfg ]; then
        update-grub || warn "update-grub failed; the boot menu changes after the next kernel update"
    fi
}

case "$1" in
    configure)
        login_screen
        boot_splash
        boot_menu
        ;;
    triggered)
        # GNOME Shell's theme was updated: rebuild the login screen on top of it.
        login_screen
        ;;
esac

exit 0
