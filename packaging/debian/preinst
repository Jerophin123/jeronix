#!/bin/sh
# jeronix-desktop preinst: moves the Ubuntu files JERONIX replaces aside
# (<file>.ubuntu) before the package's own versions are unpacked. postrm
# moves them back on removal. Generated by packaging/jeronix_payload.py.
set -e

PKG=jeronix-desktop
DIVERSIONS="@DIVERSIONS@"

case "$1" in
    install|upgrade)
        for path in $DIVERSIONS; do
            dpkg-divert --package "$PKG" --add --rename --divert "$path.ubuntu" "$path"
        done
        ;;
esac

exit 0
