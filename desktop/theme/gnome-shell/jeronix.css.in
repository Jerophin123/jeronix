/* JERONIX GNOME Shell overlay, @mode@ variant.
 *
 * Generated by scripts/jeronix_design.py from design/tokens/tokens.json
 * (tokens @tokens-version@). Do not edit the generated file; edit
 * desktop/theme/gnome-shell/jeronix.css.in or the tokens instead.
 *
 * Target: GNOME Shell @shell-versions@. Loaded by the jeronix-shell-theme
 * extension on top of the session's default theme (Yaru on Ubuntu), so only
 * properties JERONIX changes are set here. !important is used only where the
 * default theme itself uses it (panel background, focus rings).
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

/* ---- Top panel --------------------------------------------------------- */

#panel {
  background-color: @panel@ !important;
  transition-duration: @duration-normal@;
}

#panel:overview,
#panel.unlock-screen,
#panel.login-screen {
  background-color: transparent !important;
}

#panel .panel-button {
  color: @on-panel@;
  border-radius: @radius-pill@;
  transition-duration: @duration-fast@;
}

#panel .panel-button:hover {
  box-shadow: inset 0 0 0 100px @panel-hover@;
}

#panel .panel-button:active,
#panel .panel-button:checked {
  box-shadow: inset 0 0 0 100px @panel-pressed@;
}

#panel .panel-button:focus {
  box-shadow: inset 0 0 0 @focus-width@ @on-panel@;
}

#panel .panel-button.clock-display .clock {
  color: @on-panel@;
}

/* ---- Popovers and menus ----------------------------------------------- */

.popup-menu {
  color: @text@;
  min-width: @popover-min-width@;
}

.popup-menu-content,
.candidate-popup-content {
  background-color: @surface-raised@;
  color: @text@;
  border: @border-width@ solid @border@;
  border-radius: @radius-large@;
  padding: @space-xs@;
  box-shadow: @shadow-overlay@;
}

.popup-menu-item {
  color: @text@;
  border-radius: @radius-medium@;
  spacing: @space-sm@;
}

.popup-menu-item:hover,
.popup-menu-item:selected {
  background-color: @hover@;
  color: @text@;
}

.popup-menu-item:active {
  background-color: @pressed@;
}

.popup-menu-item:checked {
  background-color: @selected@;
}

.popup-menu-item:insensitive {
  color: @text-disabled@;
}

.popup-sub-menu {
  background-color: @surface-overlay@;
  border-radius: @radius-medium@;
}

.popup-separator-menu-item .popup-separator-menu-item-separator {
  background-color: @border@;
}

.popup-menu-ornament,
.popup-inactive-menu-item {
  color: @text-secondary@;
}

/* ---- Quick Settings ---------------------------------------------------- */

.quick-settings {
  padding: @space-md@;
  border-radius: @radius-large@;
}

.quick-settings-grid {
  spacing-rows: @space-sm@;
  spacing-columns: @space-sm@;
}

.quick-toggle {
  background-color: @surface-overlay@;
  color: @text@;
  min-height: @control-min-height@;
  transition-duration: @duration-fast@;
}

.quick-toggle:hover {
  background-color: @control-hover@;
}

.quick-toggle:active {
  background-color: @control-pressed@;
}

.quick-toggle:checked,
.quick-toggle-has-menu .quick-toggle-menu-button:checked {
  background-color: @accent@;
  color: @on-accent@;
}

.quick-toggle:checked:hover,
.quick-toggle-has-menu .quick-toggle-menu-button:checked:hover {
  background-color: @accent-strong@;
  color: @on-accent@;
}

.quick-toggle .quick-toggle-title {
  font-weight: @weight-bold@;
}

.quick-toggle .quick-toggle-subtitle {
  font-weight: @weight-regular@;
}

.quick-toggle-menu {
  background-color: @surface-overlay@;
  color: @text@;
  border-radius: @radius-large@;
}

.quick-toggle-menu .header .title {
  color: @text@;
  font-size: @font-heading@;
}

.quick-toggle-menu .header .subtitle {
  color: @text-muted@;
}

.quick-slider .slider,
.osd-window .level,
.slider {
  color: @text@;
  -barlevel-background-color: @border@;
  -barlevel-active-background-color: @accent@;
}

/* ---- Application overview, workspaces and search ----------------------- */

.overview-tile,
.grid-search-result {
  border-radius: @radius-large@;
  transition-duration: @duration-fast@;
}

.overview-tile:hover,
.grid-search-result:hover {
  background-color: @hover@;
}

.overview-tile:active,
.grid-search-result:active {
  background-color: @pressed@;
}

.overview-tile:selected,
.overview-tile:highlighted,
.overview-tile:checked,
.grid-search-result:selected {
  background-color: @selected@;
}

.app-grid-running-dot {
  background-color: @accent@;
}

.workspace-background {
  border-radius: @radius-large@;
}

.search-entry {
  background-color: @surface-raised@;
  color: @text@;
  border: @border-width@ solid @border@;
  border-radius: @radius-pill@;
  width: @search-entry-width@;
  selection-background-color: @selection@;
  selected-color: @text@;
}

.search-entry:hover {
  border-color: @text-muted@;
}

.search-entry StLabel.hint-text {
  color: @text-muted@;
}

.search-section-content {
  background-color: @surface-raised@;
  color: @text@;
  border-radius: @radius-large@;
  padding: @space-sm@;
}

.list-search-result,
.search-provider-icon {
  color: @text@;
  border-radius: @radius-medium@;
}

.list-search-result:hover,
.search-provider-icon:hover {
  background-color: @hover@;
}

.list-search-result:selected,
.search-provider-icon:selected {
  background-color: @selected@;
}

.list-search-result .list-search-result-description,
.search-statustext {
  color: @text-muted@;
}

/* ---- Notifications, calendar and message list -------------------------- */

.notification-banner {
  border-radius: @radius-large@;
  box-shadow: @shadow-overlay@;
}

.message {
  background-color: @surface-overlay@;
  color: @text@;
  border-radius: @radius-large@;
}

.message:hover {
  background-color: @control-hover@;
}

.message .message-header .message-source-title,
.message .message-header .event-time,
.message .message-body {
  color: @text-secondary@;
}

.message .message-title {
  color: @text@;
  font-weight: @weight-bold@;
}

.notification-button {
  border-radius: @radius-pill@;
}

.message-list .message-list-placeholder {
  color: @text-muted@;
}

.events-button,
.world-clocks-button,
.weather-button {
  background-color: @surface-overlay@;
  color: @text@;
  border-radius: @radius-large@;
}

.events-button:hover,
.world-clocks-button:hover,
.weather-button:hover {
  background-color: @control-hover@;
}

.calendar .calendar-day-heading {
  color: @text-muted@;
}

.calendar .calendar-day.calendar-today {
  background-color: @accent@;
  color: @on-accent@;
}

/* ---- Switchers, OSDs and dialogs --------------------------------------- */

.switcher-list,
.workspace-switcher,
.resize-popup,
.osd-window {
  background-color: @surface-raised@;
  color: @text@;
  border: @border-width@ solid @border@;
  border-radius: @radius-large@;
  box-shadow: @shadow-overlay@;
}

.switcher-list .item-box {
  border-radius: @radius-medium@;
}

.switcher-list .item-box:selected {
  background-color: @selected@;
  color: @text@;
}

.modal-dialog {
  background-color: @surface-raised@;
  color: @text@;
  border: @border-width@ solid @border@;
  border-radius: @radius-large@;
}

.modal-dialog .modal-dialog-button-box {
  background-color: @surface-overlay@;
}

/* ---- Keyboard focus ------------------------------------------------------
 * The default theme draws focus as an inset box-shadow marked !important,
 * so the JERONIX ring must be !important too. On accent-filled controls the
 * ring uses on-accent, which keeps it visible against the accent.
 */

.button:focus,
.icon-button:focus,
.quick-toggle:focus,
.quick-toggle-menu-button:focus,
.popup-menu-item:focus,
.overview-tile:focus,
.grid-search-result:focus,
.list-search-result:focus,
.search-provider-icon:focus,
.message:focus,
.notification-button:focus,
.events-button:focus,
.world-clocks-button:focus,
.weather-button:focus,
.calendar .calendar-day:focus,
.modal-dialog .modal-dialog-button-box .modal-dialog-button:focus,
.switcher-list .item-box:focus {
  box-shadow: inset 0 0 0 @focus-width@ @focus-ring@ !important;
}

.quick-toggle:checked:focus,
.calendar .calendar-day.calendar-today:focus {
  box-shadow: inset 0 0 0 @focus-width@ @on-accent@ !important;
}

.search-entry:focus,
StEntry:focus {
  box-shadow: inset 0 0 0 @focus-width@ @focus-ring@ !important;
}
