{
  "schema": 2,
  "id": "studio",
  "name": "Studio",
  "version": "0.1.0",
  "summary": "Workspace-first for focused work: four fixed workspaces on Super+1–4 and a dock that appears on demand.",
  "description": "A productivity layout: four fixed workspaces, always numbered in the top bar and reachable with Super+1 to Super+4 (Super+Shift+number moves the focused window there). Alt+Tab shows only the current workspace's windows. The dock sits on the right edge and appears when you touch it, so windows get the full screen.",
  "gnome_shell": ["50"],
  "settings": [
    {"schema": "org.gnome.desktop.interface", "key": "icon-theme", "value": "JERONIX",
     "reason": "Original JERONIX icons; anything JERONIX does not draw falls back to Yaru and Adwaita."},
    {"schema": "org.gnome.desktop.interface", "key": "color-scheme", "value": "prefer-dark",
     "reason": "Dark surfaces for long sessions."},
    {"schema": "org.gnome.desktop.interface", "key": "enable-hot-corners", "value": false,
     "reason": "Workspaces are switched from the keyboard and the top bar instead."},
    {"schema": "org.gnome.desktop.interface", "key": "clock-show-weekday", "value": true,
     "reason": "Weekday next to the time."},
    {"schema": "org.gnome.desktop.wm.preferences", "key": "num-workspaces", "value": 4,
     "reason": "Four fixed workspaces, one per context."},
    {"schema": "org.gnome.desktop.wm.preferences", "key": "button-layout", "value": "appmenu:minimize,maximize,close",
     "reason": "Window controls within reach."},
    {"schema": "org.gnome.mutter", "key": "dynamic-workspaces", "value": false,
     "reason": "Fixed workspaces keep their numbers."},
    {"schema": "org.gnome.mutter", "key": "workspaces-only-on-primary", "value": false,
     "reason": "Every monitor switches together, so a workspace is a whole context."},
    {"schema": "org.gnome.mutter", "key": "edge-tiling", "value": true,
     "reason": "Super+Left/Right and drag-to-edge tiling."},
    {"schema": "org.gnome.mutter", "key": "center-new-windows", "value": true,
     "reason": "Predictable placement."},
    {"schema": "org.gnome.shell.app-switcher", "key": "current-workspace-only", "value": true,
     "reason": "Alt+Tab stays within the current context."},
    {"schema": "org.gnome.shell.keybindings", "key": "switch-to-application-1", "value": [],
     "reason": "Frees Super+1 for workspace 1."},
    {"schema": "org.gnome.shell.keybindings", "key": "switch-to-application-2", "value": [],
     "reason": "Frees Super+2 for workspace 2."},
    {"schema": "org.gnome.shell.keybindings", "key": "switch-to-application-3", "value": [],
     "reason": "Frees Super+3 for workspace 3."},
    {"schema": "org.gnome.shell.keybindings", "key": "switch-to-application-4", "value": [],
     "reason": "Frees Super+4 for workspace 4."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "switch-to-workspace-1", "value": ["<Super>1", "<Super>Home"],
     "reason": "Super+1 goes to workspace 1 (Super+Home still works)."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "switch-to-workspace-2", "value": ["<Super>2"],
     "reason": "Super+2 goes to workspace 2."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "switch-to-workspace-3", "value": ["<Super>3"],
     "reason": "Super+3 goes to workspace 3."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "switch-to-workspace-4", "value": ["<Super>4"],
     "reason": "Super+4 goes to workspace 4."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "move-to-workspace-1", "value": ["<Super><Shift>1", "<Super><Shift>Home"],
     "reason": "Super+Shift+1 moves the window to workspace 1."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "move-to-workspace-2", "value": ["<Super><Shift>2"],
     "reason": "Super+Shift+2 moves the window to workspace 2."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "move-to-workspace-3", "value": ["<Super><Shift>3"],
     "reason": "Super+Shift+3 moves the window to workspace 3."},
    {"schema": "org.gnome.desktop.wm.keybindings", "key": "move-to-workspace-4", "value": ["<Super><Shift>4"],
     "reason": "Super+Shift+4 moves the window to workspace 4."},
    {"schema": "org.gnome.desktop.background", "key": "picture-uri", "value": {"asset": "wallpaper-light"},
     "reason": "JERONIX light wallpaper."},
    {"schema": "org.gnome.desktop.background", "key": "picture-uri-dark", "value": {"asset": "wallpaper-dark"},
     "reason": "JERONIX dark wallpaper."},
    {"schema": "org.gnome.shell.extensions.jeronix-panel", "key": "show-menu-label", "value": false,
     "reason": "A compact symbol-only menu leaves room for workspaces and the window title."},
    {"schema": "org.gnome.shell.extensions.jeronix-panel", "key": "show-workspaces", "value": true,
     "reason": "Numbered workspaces are the center of this layout."},
    {"schema": "org.gnome.shell.extensions.jeronix-panel", "key": "show-window-context", "value": true,
     "reason": "Always see which application has focus."},
    {"schema": "org.gnome.shell.extensions.jeronix-panel", "key": "hide-activities", "value": true,
     "reason": "The JERONIX menu replaces Activities."},
    {"schema": "org.gnome.shell.extensions.jeronix-dock", "key": "position", "value": "right",
     "reason": "Out of the way of wide documents and code."},
    {"schema": "org.gnome.shell.extensions.jeronix-dock", "key": "behavior", "value": "autohide",
     "reason": "Appears when the pointer touches the right edge; windows get the whole screen."},
    {"schema": "org.gnome.shell.extensions.jeronix-dock", "key": "icon-size", "value": 36,
     "reason": "Compact icons for a dock that appears on demand."},
    {"schema": "org.gnome.shell.extensions.jeronix-dock", "key": "show-running", "value": true,
     "reason": "Running applications appear after favorites."},
    {"schema": "org.gnome.shell.extensions.jeronix-dock", "key": "show-previews", "value": true,
     "reason": "Window previews on hover."}
  ],
  "extensions": {
    "enable": ["jeronix-shell-theme@jeronix", "jeronix-panel@jeronix", "jeronix-dock@jeronix",
               "jeronix-quick-settings@jeronix"],
    "disable": ["ubuntu-dock@ubuntu.com", "ding@rastersoft.com"]
  },
  "limitations": [
    "Super+1 to Super+4 no longer launch dock favorites in this layout; restoring the snapshot brings that back.",
    "Workspaces beyond four are not created automatically."
  ]
}
