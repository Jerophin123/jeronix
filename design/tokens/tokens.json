{
  "schema": 2,
  "name": "jeronix",
  "version": "0.3.0",
  "brand": {
    "graphite": "#1E1D1B",
    "graphite-deep": "#141413",
    "copper": "#C98352",
    "copper-light": "#E2A47A",
    "copper-deep": "#8C4E25",
    "ivory": "#EFE8DA",
    "paper": "#F5F1E9",
    "sand": "#E6DDCC",
    "sage": "#8FAE94",
    "sage-light": "#CFE0D1",
    "moss": "#3E5E45",
    "charcoal": "#1C1E1D"
  },
  "color": {
    "dark": {
      "surface": "#1E1D1B",
      "surface-raised": "#282624",
      "surface-overlay": "#33302C",
      "panel": "#141413",
      "on-panel": "#EFE8DA",
      "panel-accent": "#E2A47A",
      "border": "#46413A",
      "text": "#EFE8DA",
      "text-secondary": "#D3C9B7",
      "text-muted": "#ADA390",
      "accent": "#D08A5C",
      "accent-strong": "#E2A47A",
      "on-accent": "#1E130C",
      "accent-secondary": "#93B09A",
      "focus-ring": "#E2A47A",
      "success": "#93C49E",
      "warning": "#E0B867",
      "danger": "#E58A7F"
    },
    "light": {
      "surface": "#F5F1E9",
      "surface-raised": "#FFFDF8",
      "surface-overlay": "#ECE5D8",
      "panel": "#1E1D1B",
      "on-panel": "#EFE8DA",
      "panel-accent": "#E2A47A",
      "border": "#D6CCBA",
      "text": "#23211E",
      "text-secondary": "#463F37",
      "text-muted": "#625A4F",
      "accent": "#A65F30",
      "accent-strong": "#8C4E25",
      "on-accent": "#FFFFFF",
      "accent-secondary": "#4F7357",
      "focus-ring": "#8C4E25",
      "success": "#2E6B3F",
      "warning": "#7A5600",
      "danger": "#A8261E"
    }
  },
  "interaction": {
    "description": "Opacity of the text color laid over a surface for hover/pressed/disabled, and of the accent for selections.",
    "hover-opacity": 0.08,
    "pressed-opacity": 0.14,
    "selected-opacity": 0.24,
    "disabled-opacity": 0.5
  },
  "contrast": {
    "description": "WCAG 2.x minimum ratios [foreground, background, ratio], checked in both modes by tests/unit/test_design_tokens.py. 4.5 = body text, 3.0 = large text and non-text UI. control-hover is derived by scripts/jeronix_design.py.",
    "pairs": [
      ["text", "surface", 4.5],
      ["text", "surface-raised", 4.5],
      ["text", "surface-overlay", 4.5],
      ["text", "control-hover", 4.5],
      ["text-secondary", "surface-raised", 4.5],
      ["text-secondary", "surface-overlay", 4.5],
      ["text-muted", "surface", 4.5],
      ["text-muted", "surface-raised", 4.5],
      ["on-panel", "panel", 4.5],
      ["panel", "panel-accent", 4.5],
      ["panel-accent", "panel", 3.0],
      ["on-accent", "accent", 4.5],
      ["on-accent", "accent-strong", 4.5],
      ["accent", "surface", 3.0],
      ["accent", "surface-raised", 3.0],
      ["accent-secondary", "surface", 3.0],
      ["accent-secondary", "surface-raised", 3.0],
      ["focus-ring", "surface", 3.0],
      ["focus-ring", "surface-raised", 3.0],
      ["focus-ring", "surface-overlay", 3.0],
      ["success", "surface", 4.5],
      ["warning", "surface", 4.5],
      ["danger", "surface", 4.5]
    ],
    "brand-pairs": [
      ["copper", "graphite", 3.0],
      ["copper-light", "graphite", 3.0],
      ["sage-light", "graphite", 3.0],
      ["ivory", "graphite", 4.5],
      ["copper-deep", "paper", 3.0],
      ["copper-deep", "sand", 3.0],
      ["moss", "paper", 3.0],
      ["graphite", "paper", 4.5]
    ]
  },
  "typography": {
    "family-ui": "Ubuntu Sans",
    "family-mono": "Ubuntu Sans Mono",
    "base-size-pt": 11,
    "scale": {
      "caption": 0.82,
      "body": 1.0,
      "heading": 1.18,
      "title": 1.45,
      "display": 2.0
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "spacing-px": {
    "none": 0,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64
  },
  "component": {
    "border-width-px": 1,
    "focus-ring-width-px": 2,
    "control-min-height-px": 36,
    "popover-min-width-em": 15,
    "search-entry-width-em": 24
  },
  "radius-px": {
    "small": 6,
    "medium": 12,
    "large": 18,
    "pill": 999
  },
  "elevation": {
    "raised": {"offset-y-px": 1, "blur-px": 3, "spread-px": 0, "opacity": 0.24},
    "overlay": {"offset-y-px": 6, "blur-px": 18, "spread-px": 0, "opacity": 0.32}
  },
  "motion": {
    "duration-ms": {
      "instant": 0,
      "fast": 120,
      "normal": 200,
      "slow": 320
    },
    "easing": "ease-out-quad",
    "respect-reduced-motion": true
  },
  "icon-size-px": [16, 24, 32, 48, 64, 128, 256, 512],
  "wallpaper": {
    "description": "Brand color names used by the procedural wallpapers in scripts/jeronix_design.py.",
    "dark": {"base-top": "graphite", "base-bottom": "graphite-deep", "line": "copper", "seed": "sage-light"},
    "light": {"base-top": "paper", "base-bottom": "sand", "line": "copper-deep", "seed": "moss"}
  }
}
