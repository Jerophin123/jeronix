{
  "schema": 1,
  "name": "jeronix",
  "version": "0.1.0",
  "brand": {
    "charcoal": "#1C1E1D",
    "sage": "#8FAE94",
    "sage-light": "#CFE0D1"
  },
  "color": {
    "dark": {
      "surface": "#1C1E1D",
      "surface-raised": "#252826",
      "surface-overlay": "#2F3330",
      "border": "#3D433E",
      "text": "#ECEFEC",
      "text-muted": "#A9B2AB",
      "accent": "#8FAE94",
      "accent-strong": "#A9C5AD",
      "on-accent": "#14211A",
      "focus-ring": "#A9C5AD",
      "success": "#8FC79A",
      "warning": "#D9B56A",
      "danger": "#E0877D"
    },
    "light": {
      "surface": "#F4F5F2",
      "surface-raised": "#FFFFFF",
      "surface-overlay": "#FAFBF8",
      "border": "#CDD3CC",
      "text": "#1C1F1D",
      "text-muted": "#535C55",
      "accent": "#4F7357",
      "accent-strong": "#3E5E45",
      "on-accent": "#FFFFFF",
      "focus-ring": "#3E5E45",
      "success": "#2E6B3F",
      "warning": "#7A5600",
      "danger": "#A8261E"
    }
  },
  "contrast": {
    "description": "WCAG 2.x minimum ratios [foreground, background, ratio], checked in both modes by tests/unit/test_design_tokens.py. 4.5 = body text, 3.0 = large text and non-text UI.",
    "pairs": [
      ["text", "surface", 4.5],
      ["text", "surface-raised", 4.5],
      ["text", "surface-overlay", 4.5],
      ["text-muted", "surface", 4.5],
      ["text-muted", "surface-raised", 4.5],
      ["on-accent", "accent", 4.5],
      ["on-accent", "accent-strong", 4.5],
      ["accent", "surface", 3.0],
      ["focus-ring", "surface", 3.0],
      ["focus-ring", "surface-raised", 3.0],
      ["success", "surface", 4.5],
      ["warning", "surface", 4.5],
      ["danger", "surface", 4.5]
    ]
  },
  "typography": {
    "family-ui": "Ubuntu Sans",
    "family-mono": "Ubuntu Sans Mono",
    "base-size-pt": 11,
    "scale": {
      "caption": 0.82,
      "body": 1.0,
      "heading": 1.18,
      "title": 1.45,
      "display": 2.0
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "spacing-px": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius-px": {
    "small": 6,
    "medium": 12,
    "large": 18,
    "pill": 999
  },
  "elevation": {
    "none": "none",
    "raised": "0 1px 3px rgba(0, 0, 0, 0.24)",
    "overlay": "0 6px 18px rgba(0, 0, 0, 0.32)"
  },
  "motion": {
    "duration-ms": {
      "instant": 0,
      "fast": 120,
      "normal": 200,
      "slow": 320
    },
    "easing": "ease-out-quad",
    "respect-reduced-motion": true
  },
  "icon-size-px": [16, 24, 32, 48, 64, 128, 256]
}
