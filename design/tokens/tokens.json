{
  "schema": 2,
  "name": "jeronix",
  "version": "0.2.0",
  "brand": {
    "charcoal": "#1C1E1D",
    "charcoal-deep": "#121413",
    "sage": "#8FAE94",
    "sage-light": "#CFE0D1",
    "moss": "#3E5E45",
    "fog": "#E4EAE2",
    "paper": "#F4F5F2"
  },
  "color": {
    "dark": {
      "surface": "#1C1E1D",
      "surface-raised": "#252826",
      "surface-overlay": "#2F3330",
      "panel": "#121413",
      "on-panel": "#ECEFEC",
      "border": "#3D433E",
      "text": "#ECEFEC",
      "text-secondary": "#C9D0CA",
      "text-muted": "#A9B2AB",
      "accent": "#8FAE94",
      "accent-strong": "#A9C5AD",
      "on-accent": "#14211A",
      "focus-ring": "#A9C5AD",
      "success": "#8FC79A",
      "warning": "#D9B56A",
      "danger": "#E0877D"
    },
    "light": {
      "surface": "#F4F5F2",
      "surface-raised": "#FFFFFF",
      "surface-overlay": "#EBEEE9",
      "panel": "#1C1E1D",
      "on-panel": "#ECEFEC",
      "border": "#CDD3CC",
      "text": "#1C1F1D",
      "text-secondary": "#3A423C",
      "text-muted": "#535C55",
      "accent": "#4F7357",
      "accent-strong": "#3E5E45",
      "on-accent": "#FFFFFF",
      "focus-ring": "#3E5E45",
      "success": "#2E6B3F",
      "warning": "#7A5600",
      "danger": "#A8261E"
    }
  },
  "interaction": {
    "description": "Opacity of the text color laid over a surface for hover/pressed/disabled, and of the accent for selections.",
    "hover-opacity": 0.08,
    "pressed-opacity": 0.14,
    "selected-opacity": 0.24,
    "disabled-opacity": 0.5
  },
  "contrast": {
    "description": "WCAG 2.x minimum ratios [foreground, background, ratio], checked in both modes by tests/unit/test_design_tokens.py. 4.5 = body text, 3.0 = large text and non-text UI. control-hover is derived by scripts/jeronix_design.py.",
    "pairs": [
      ["text", "surface", 4.5],
      ["text", "surface-raised", 4.5],
      ["text", "surface-overlay", 4.5],
      ["text", "control-hover", 4.5],
      ["text-secondary", "surface-raised", 4.5],
      ["text-secondary", "surface-overlay", 4.5],
      ["text-muted", "surface", 4.5],
      ["text-muted", "surface-raised", 4.5],
      ["on-panel", "panel", 4.5],
      ["on-accent", "accent", 4.5],
      ["on-accent", "accent-strong", 4.5],
      ["accent", "surface", 3.0],
      ["accent", "surface-raised", 3.0],
      ["focus-ring", "surface", 3.0],
      ["focus-ring", "surface-raised", 3.0],
      ["focus-ring", "surface-overlay", 3.0],
      ["success", "surface", 4.5],
      ["warning", "surface", 4.5],
      ["danger", "surface", 4.5]
    ],
    "brand-pairs": [
      ["sage", "charcoal", 3.0],
      ["sage-light", "charcoal", 3.0],
      ["moss", "paper", 3.0],
      ["moss", "fog", 3.0],
      ["charcoal", "paper", 4.5]
    ]
  },
  "typography": {
    "family-ui": "Ubuntu Sans",
    "family-mono": "Ubuntu Sans Mono",
    "base-size-pt": 11,
    "scale": {
      "caption": 0.82,
      "body": 1.0,
      "heading": 1.18,
      "title": 1.45,
      "display": 2.0
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "spacing-px": {
    "none": 0,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64
  },
  "component": {
    "border-width-px": 1,
    "focus-ring-width-px": 2,
    "control-min-height-px": 36,
    "popover-min-width-em": 15,
    "search-entry-width-em": 24
  },
  "radius-px": {
    "small": 6,
    "medium": 12,
    "large": 18,
    "pill": 999
  },
  "elevation": {
    "raised": {"offset-y-px": 1, "blur-px": 3, "spread-px": 0, "opacity": 0.24},
    "overlay": {"offset-y-px": 6, "blur-px": 18, "spread-px": 0, "opacity": 0.32}
  },
  "motion": {
    "duration-ms": {
      "instant": 0,
      "fast": 120,
      "normal": 200,
      "slow": 320
    },
    "easing": "ease-out-quad",
    "respect-reduced-motion": true
  },
  "icon-size-px": [16, 24, 32, 48, 64, 128, 256, 512],
  "wallpaper": {
    "description": "Brand color names used by the procedural wallpapers in scripts/jeronix_design.py.",
    "dark": {"base-top": "charcoal", "base-bottom": "charcoal-deep", "line": "sage", "seed": "sage-light"},
    "light": {"base-top": "paper", "base-bottom": "fog", "line": "moss", "seed": "moss"}
  }
}
